{
  "model": "sonnet",
  "permissions": {
    "deny": [
      "Read(.env)", "Read(**/.env)", "Read(~/.ssh/**)", "Read(~/.aws/**)", "Read(~/.tauri/**)",
      "Bash(ssh:*)", "Bash(scp:*)", "Bash(curl:*)", "Bash(wget:*)"
    ],
    "ask": [
      "Edit(.claude/hooks/**)", "Write(.claude/hooks/**)",
      "Edit(.claude/agents/**)", "Write(.claude/agents/**)",
      "Edit(.claude/settings.json)", "Write(.claude/settings.json)",
      "Edit(.claude/settings.local.json)", "Write(.claude/settings.local.json)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "filesystem": { "allowWrite": ["~/.npm", "~/.cache", "~/.cargo", "~/.rustup"] },
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "crates.io", "index.crates.io", "static.crates.io",
        "github.com"
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/critical-rules.cjs"] }] }
    ],
    "PreToolUse": [
      { "matcher": "Bash|PowerShell", "hooks": [
        { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash-push.cjs"] },
        { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-harness.cjs"] },
        { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-remote-exec.cjs"] },
        { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-secrets.cjs"] }
      ] },
      { "matcher": "Edit|Write", "hooks": [
        { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-protected-files.cjs"] }
      ] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write", "hooks": [
        { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/post-edit-checks.cjs"] }
      ] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/build-gate.cjs"], "timeout": 270 }] }
    ]
  }
}
