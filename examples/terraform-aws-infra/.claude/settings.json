{
  "model": "sonnet",
  "permissions": {
    "deny": [
      "Read(.env)", "Read(**/.env)", "Read(~/.ssh/**)", "Read(~/.aws/**)",
      "Bash(ssh:*)", "Bash(scp:*)", "Bash(curl:*)", "Bash(wget:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node .claude/hooks/critical-rules.cjs" }] }
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "node .claude/hooks/guard-bash.cjs" }] },
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "node .claude/hooks/secret-scan.cjs" }] },
      { "matcher": "Edit|Write", "hooks": [{ "type": "command", "command": "node .claude/hooks/protected-file-guard.cjs" }] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write", "hooks": [{ "type": "command", "command": "node .claude/hooks/domain-guard-note.cjs" }] }
    ],
    "PreModelSwitch": [
      { "hooks": [{ "type": "command", "command": "node .claude/hooks/cost-guard.cjs" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node .claude/hooks/build-gate.cjs", "timeout": 90000 }] }
    ]
  },
  "mcpServers": {}
}
